msgstr "5, дуже добре"

#: audio_describer/models/evaluation_model.py:46
msgid "Global listening, without the picture"
msgstr "Загальне прослуховування, без зображення"

#: audio_describer/models/evaluation_model.py:46
msgid "Analysis, with the picture"
msgstr "Аналіз, із зображенням"

#: audio_describer/models/evaluation_model.py:13
msgid ""
"Without the picture, are the action, the characters, the place and the time "
"understood?"
msgstr "Чи зрозумілі без зображення дія, персонажі, місце та час?"

#: audio_describer/models/evaluation_model.py:14
msgid "Does the description avoid covering dialogue?"
msgstr "Чи не перекриває опис діалоги?"

#: audio_describer/models/evaluation_model.py:15
msgid "Does it describe the images rather than explain the plot?"
msgstr "Чи описує він зображення, а не пояснює сюжет?"

#: audio_describer/models/evaluation_model.py:16
msgid "Is it neither too sparse nor too present?"
msgstr "Чи не надто він скупий і не надто нав'язливий?"

#: audio_describer/models/evaluation_model.py:17
msgid "Does it stay inside the fiction (no actors, no filming jargon)?"
msgstr ""
"Чи залишається він у межах вигаданого світу (без акторів і знімального "
"жаргону)?"

#: audio_describer/models/evaluation_model.py:18
msgid "Is the language correct and clear?"
msgstr "Чи правильна й зрозуміла мова?"

#: audio_describer/models/evaluation_model.py:19
msgid "Are the voice and the pace pleasant and suitable?"
msgstr "Чи приємні й доречні голос і темп?"

#: audio_describer/models/evaluation_model.py:20
msgid "With the picture: is it free of factual errors and omissions?"
msgstr "Із зображенням: чи немає фактичних помилок і пропусків?"

#: audio_describer/models/evaluation_model.py:21
msgid "Are looks, faces and gestures interpreted correctly?"
msgstr "Чи правильно інтерпретовано погляди, обличчя та жести?"

#: audio_describer/models/evaluation_model.py:22
msgid "Are the chronology and the rhythm of the film respected?"
msgstr "Чи дотримано хронологію та ритм фільму?"

#: audio_describer/models/evaluation_model.py:23
msgid "Is each description well placed relative to sound effects and music?"
msgstr "Чи добре розміщено кожен опис відносно звукових ефектів і музики?"

#: audio_describer/models/evaluation_model.py:24
msgid "Is on-screen text read?"
msgstr "Чи читається текст на екрані?"

#: audio_describer/models/evaluation_model.py:25
msgid "Does the style match the film?"
msgstr "Чи відповідає стиль фільму?"

#: audio_describer/models/evaluation_model.py:35
msgid "measured: %(n)d of %(total)d descriptions over sound or dialogue"
msgstr "виміряно: %(n)d із %(total)d описів поверх звуку чи діалогу"

#: audio_describer/models/evaluation_model.py:36
msgid ""
"measured: %(total)d descriptions, longest stretch without description "
"%(gap)s"
msgstr "виміряно: %(total)d описів, найдовший проміжок без опису %(gap)s"

#: audio_describer/models/evaluation_model.py:37
msgid "measured: %(wps).1f words per second (target 2.7 or less)"
msgstr "виміряно: %(wps).1f слів за секунду (ціль 2,7 або менше)"

#: audio_describer/models/evaluation_model.py:38
msgid "measured: %d descriptions marked uncertain by the AI check"
msgstr "виміряно: описів, позначених перевіркою ШІ як непевні: %d"

#: audio_describer/models/evaluation_model.py:39
msgid "measured: %d descriptions read on-screen text"
msgstr "виміряно: описів, що читають текст на екрані: %d"

#: audio_describer/models/evaluation_model.py:47
msgid "Audio description evaluation (CSA 2020 grid): %s"
msgstr "Оцінка аудіоопису (таблиця CSA 2020): %s"

#: audio_describer/models/evaluation_model.py:58
